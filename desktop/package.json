{
  "name": "@lockedinlabs-ai/lockedin-flow-desktop-build",
  "version": "0.5.0-alpha.1",
  "private": true,
  "description": "Build tooling for the native LockedIn Flow Windows and Linux desktop app",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "icons": "tauri icon ../branding/raster/icon-1024.png --output app/icons",
    "provision:model": "node scripts/provision-model.mjs --download",
    "verify:model": "node scripts/provision-model.mjs --verify",
    "inventory": "node scripts/generate-inventory.mjs",
    "verify:backport": "node scripts/verify-glib-backport.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --workspace --all-targets --locked"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "spdx-expression-parse": "5.0.0"
  }
}
