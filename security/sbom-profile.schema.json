{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LockedinLabs-AI/lockedin-flow/main/security/sbom-profile.schema.json",
  "title": "LockedIn Flow CycloneDX 1.6 build SBOM profile",
  "$comment": "Strict local profile for build evidence and GitHub SBOM attestations. It is intentionally narrower than, and does not replace, the official CycloneDX 1.6 schema referenced by each generated document.",
  "type": "object",
  "required": [
    "$schema",
    "bomFormat",
    "specVersion",
    "serialNumber",
    "version",
    "metadata",
    "components",
    "dependencies",
    "compositions"
  ],
  "properties": {
    "$schema": {
      "const": "https://cyclonedx.org/schema/bom-1.6.schema.json"
    },
    "bomFormat": {
      "const": "CycloneDX"
    },
    "specVersion": {
      "const": "1.6"
    },
    "serialNumber": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "required": ["lifecycles", "component", "properties"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "bom-ref", "name", "licenses", "properties"]
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "dependsOn"]
      }
    },
    "compositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["aggregate", "assemblies", "dependencies"]
      }
    }
  },
  "additionalProperties": false
}
